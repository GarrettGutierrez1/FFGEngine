function(print_imported_targets)
    get_property(IMPORTED_TARGETS DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" PROPERTY IMPORTED_TARGETS)
    if(IMPORTED_TARGETS)
        list(SORT IMPORTED_TARGETS CASE INSENSITIVE)
        message(STATUS "Imported targets:")
        foreach(target IN LISTS IMPORTED_TARGETS)
            message(STATUS "  - ${target}")
        endforeach()
    else()
        message(STATUS "No imported targets")
    endif()
endfunction()

function(warn_untracked_files TARGET_NAMES SOURCE_DIRECTORIES HEADER_DIRECTORIES)
    foreach(TARGET_NAME IN LISTS ${TARGET_NAMES})
        get_target_property(TARGET_TRACKED_SOURCES ${TARGET_NAME} SOURCE_SET)
        if(TARGET_TRACKED_SOURCES)
            list(APPEND TRACKED_SOURCES ${TARGET_TRACKED_SOURCES})
        endif()
        get_target_property(TARGET_TRACKED_HEADERS ${TARGET_NAME} HEADER_SET)
        if(TARGET_TRACKED_HEADERS)
            list(APPEND TRACKED_HEADERS ${TARGET_TRACKED_HEADERS})
        endif()
    endforeach()
    if(NOT TRACKED_SOURCES)
        set(TRACKED_SOURCES "")
    endif()
    if(NOT TRACKED_HEADERS)
        set(TRACKED_HEADERS "")
    endif()
    foreach(DIRECTORY IN LISTS ${SOURCE_DIRECTORIES})
        file(GLOB_RECURSE TARGET_DISK_SOURCES LIST_DIRECTORIES false
            "${DIRECTORY}/*"
        )
        list(APPEND DISK_SOURCES ${TARGET_DISK_SOURCES})
    endforeach()
    foreach(DIRECTORY IN LISTS ${HEADER_DIRECTORIES})
        file(GLOB_RECURSE TARGET_DISK_HEADERS LIST_DIRECTORIES false
            "${DIRECTORY}/*"
        )
        list(APPEND DISK_HEADERS ${TARGET_DISK_HEADERS})
    endforeach()
    list(REMOVE_ITEM DISK_SOURCES ${TRACKED_SOURCES})
    list(REMOVE_ITEM DISK_HEADERS ${TRACKED_HEADERS})
    foreach(FILE ${DISK_SOURCES})
        message(WARNING "Untracked source file found on disk: ${FILE}")
    endforeach()
    foreach(FILE ${DISK_HEADERS})
        message(WARNING "Untracked header file found on disk: ${FILE}")
    endforeach()
endfunction()
